                to-[#31465A]/[0.18]
              "
            />
          </div>
        </motion.div>

        {/* =========================
            TEXT + LOADING
        ========================== */}
        <div
          className="
            relative z-20
            flex w-[88%] max-w-[590px]
            flex-col items-center
            text-center
          "
        >
          <motion.p
            initial={{ opacity: 0, y: 8 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.8 }}
            className="
              mb-3
              text-[10px] sm:text-[13px]

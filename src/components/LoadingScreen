              [text-shadow:0_2px_4px_rgba(255,253,247,0.95)]
            "
          >
            ⊹•┈┈౨ৎ┈┈•⊹
          </div>

          <motion.p
            animate={{ opacity: [0.65, 1, 0.65] }}
            transition={{
              duration: 2,
              repeat: Infinity,
              ease: 'easeInOut',
            }}
            className="
              mb-3
              text-[10px] sm:text-[13px]
              font-bold
              tracking-[0.23em]
              text-[#31465A]
              [text-shadow:0_2px_4px_rgba(255,253,247,0.95),0_0_14px_rgba(255,253,247,0.65)]
            "
          >
            ĐANG MỞ GIẤC MỘNG...
          </motion.p>

          {/* =========================
              LOADING BAR
          ========================== */}
          <div
            className="
              h-[6px] w-[75vw] max-w-[390px]
              overflow-hidden
              rounded-full
              bg-[#31465A]/20
              shadow-[inset_0_1px_3px_rgba(49,70,90,0.18),0_1px_7px_rgba(255,253,247,0.5)]
            "
          >
            <motion.div
              className="
                h-full
                rounded-full
                bg-gradient-to-r
                from-[#C7DFA3]
                via-[#D9F0FF]
                to-[#89B9E6]
                shadow-[0_0_9px_rgba(137,185,230,0.75)]
              "
              style={{
                width: `${progress}%`,
              }}
            />
          </div>

          <motion.p
            key={progress}
            initial={{ opacity: 0.5 }}
            animate={{ opacity: 1 }}
            className="
              mt-2

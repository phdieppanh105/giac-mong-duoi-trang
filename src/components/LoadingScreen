import React, { useEffect, useState } from 'react';
import { motion } from 'motion/react';

interface LoadingScreenProps {
  onComplete?: () => void;
}

export const LoadingScreen: React.FC<LoadingScreenProps> = ({
  onComplete,
}) => {
  const [progress, setProgress] = useState(0);
  const [isLeaving, setIsLeaving] = useState(false);

  useEffect(() => {
    const duration = 6500;
    const start = performance.now();
    let frameId: number;

    const animate = (now: number) => {
      const elapsed = now - start;
      const ratio = Math.min(elapsed / duration, 1);

      // Chạy từ 0 → 100 mượt, không đứng im
      const eased = 1 - Math.pow(1 - ratio, 1.35);
      const value = Math.floor(eased * 100);

      setProgress(value);

      if (ratio < 1) {
        frameId = requestAnimationFrame(animate);
      } else {
        setProgress(100);

        setTimeout(() => {
          setIsLeaving(true);

          setTimeout(() => {
            onComplete?.();
          }, 700);
        }, 250);
      }
    };

    frameId = requestAnimationFrame(animate);

    return () => cancelAnimationFrame(frameId);
  }, [onComplete]);

  return (
    <motion.div
      initial={{ opacity: 1 }}
      animate={{ opacity: isLeaving ? 0 : 1 }}
      transition={{ duration: 0.7, ease: 'easeInOut' }}
      className="
        fixed inset-0 z-[9999]
        flex items-center justify-center
        overflow-hidden
        bg-[#31465A]
      "
    >
      {/* =========================
          BACKGROUND GLOW
      ========================== */}
      <div
        className="
          absolute left-1/2 top-1/2
          h-[430px] w-[430px]
          -translate-x-1/2 -translate-y-1/2
          rounded-full
          bg-[#D9F0FF]/10
          blur-[80px]
        "
      />

      <div
        className="
          absolute left-1/2 top-1/2
          h-[300px] w-[300px]
          -translate-x-1/2 -translate-y-1/2
          rounded-full
          bg-[#FFFDF7]/10
          blur-[65px]
        "
      />

      {/* =========================
          STARS
      ========================== */}
      <div className="absolute inset-0 pointer-events-none">
        {[
          ['12%', '20%', '-0.3s'],
          ['23%', '68%', '-1.1s'],
          ['79%', '25%', '-0.7s'],
          ['88%', '62%', '-1.7s'],
          ['68%', '13%', '-0.1s'],
          ['35%', '16%', '-1.5s'],
          ['17%', '43%', '-2s'],
          ['83%', '45%', '-0.9s'],
          ['57%', '9%', '-1.8s'],
          ['7%', '78%', '-0.5s'],
        ].map(([left, top, delay], index) => (
          <motion.span
            key={index}
            className="
              absolute
              h-[3px] w-[3px]
              rounded-full
              bg-[#FFFDF7]
              shadow-[0_0_10px_rgba(255,253,247,0.9)]
            "
            style={{
              left,
              top,
            }}
            animate={{
              opacity: [0.2, 1, 0.2],
              scale: [0.7, 1.5, 0.7],
            }}
            transition={{
              duration: 2.4,
              repeat: Infinity,
              ease: 'easeInOut',
              delay: parseFloat(delay),
            }}
          />
        ))}
      </div>

      {/* =========================
          SOFT CLOUDS
      ========================== */}
      <motion.div
        className="
          absolute
          -left-24 bottom-[12%]
          h-20 w-[310px]
          rounded-full
          bg-[#D9F0FF]/[0.055]
          blur-[11px]
        "
        animate={{ x: [-20, 45, -20] }}
        transition={{
          duration: 14,
          repeat: Infinity,
          ease: 'easeInOut',
        }}
      />

      <motion.div
        className="
          absolute
          -right-28 top-[17%]
          h-20 w-[350px]
          rounded-full
          bg-[#D9F0FF]/[0.055]
          blur-[11px]
        "
        animate={{ x: [30, -35, 30] }}
        transition={{
          duration: 16,
          repeat: Infinity,
          ease: 'easeInOut',
          delay: -5,
        }}
      />

      {/* =========================
          CENTRAL SCENE
      ========================== */}
      <div
        className="
          relative
          flex h-full w-full
          items-center justify-center
        "
      >
        {/* =========================
            MOON
        ========================== */}
        <motion.div
          className="
            absolute
            left-1/2 top-1/2
            h-[min(82vw,430px)]
            w-[min(82vw,430px)]
            -translate-x-1/2
            -translate-y-1/2
          "
          animate={{
            y: [0, -7, 0],
          }}
          transition={{
            duration: 4,
            repeat: Infinity,
            ease: 'easeInOut',
          }}
        >
          {/* Moon glow */}
          <motion.div

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'ph.diepp.anh.105@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Characters collection: public read, admin-only write
    match /characters/{characterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Comments collection: public read, authenticated user write
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User profiles: public read for display info, owner or admin write
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Character likes: mỗi tài khoản chỉ có 1 lượt tim cho mỗi character
    match /characters/{characterId}/likes/{userId} {
      // Cho phép đọc để hiển thị tổng số tim
      allow read: if true;

      // Chỉ tài khoản đang đăng nhập mới được tim
      // Và userId của document phải đúng bằng UID của chính tài khoản đó
      allow create: if isSignedIn() &&
                    request.auth.uid == userId;

      // Chỉ chính người đã tim mới được bỏ tim
      allow delete: if isSignedIn() &&
                    request.auth.uid == userId;

      // Không cho sửa document lượt tim
      allow update: if false;
    }
  }
}
